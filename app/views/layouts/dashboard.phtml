        <script>
            $(function () {
                function applyTheme(theme) {
                    $('html').attr('data-bs-theme', theme);
                    $('#theme-icon').attr('class', theme === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill');
                    $('#theme-toggle').attr('class', theme === 'dark' ? 'btn btn-sm btn-outline-light me-2' : 'btn btn-sm btn-outline-dark me-2');                                                                                                 
                    $('#lang-btn').attr('class', theme === 'dark' ? 'btn btn-sm btn-outline-light' : 'btn btn-sm btn-outline-dark');                                                                                                      
                    $('#user-type-badge').attr('class', theme === 'dark' ? 'badge bg-secondary me-3' : 'badge bg-dark me-3');
                }                                                                                                                    

                applyTheme($('html').attr('data-bs-theme'));                                                                         

                $('#theme-toggle').on('click', function () {
                    $.post('/auth/theme/toggle', function (res) {
                        applyTheme(res.theme);                                                                                       
                    }, 'json').fail(function (xhr) {
                        console.error('Theme toggle failed', xhr.status, xhr.responseText);                                          
                    });                                                                                                              
                });                                                                                
            });                                                                                                                               
        </script>
